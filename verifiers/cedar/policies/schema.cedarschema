// Cedar schema for the temporal-proxy tool-call verifier.
//
// Every tool call - a Nexus operation, or an activity on another task queue -
// is evaluated as one authorization request:
//   principal: the worker identity completing the workflow task
//   action:    the tool, Action::"<endpoint>/<service>/<operation>" or
//              Action::"<taskQueue>/<activityType>"
//   resource:  the task queue that issued the workflow task token
//   context:   the calling workflow's ID and the tool call's parameters
//
// Each tool is its own action, so it declares the shape of its parameters
// below. A tool that isn't declared here can't be used in a validated policy,
// and Cedar's default deny rejects it.

// The calling worker identity, keyed by its subject.
entity Worker = {
  // The namespace the identity (and the calling workflow) is pinned to.
  namespace: String,
};

// The task queue that issued the workflow task token being completed.
entity TaskQueue = {
  name: String,
  namespace: String,
};

// Parameters of a tool taking a single plain JSON string
// (google.protobuf.Value), e.g. an SDK call with one string argument.
type StringArgument = {
  arg0?: {
    type: String,
    data: { value?: String },
  },
};

// Parameters of payments/billing/Charge: one JSON object argument.
type ChargeArguments = {
  arg0?: {
    type: String,
    data: {
      amount?: Long,
      currency?: String,
    },
  },
};

action "echo/echo/Echo" appliesTo {
  principal: Worker,
  resource: TaskQueue,
  context: {
    workflowId: String,
    parameterCount: Long,
    parameters: StringArgument,
  },
};

action "payments/billing/Charge" appliesTo {
  principal: Worker,
  resource: TaskQueue,
  context: {
    workflowId: String,
    parameterCount: Long,
    parameters: ChargeArguments,
  },
};

action "trusted-tools/SendEmail" appliesTo {
  principal: Worker,
  resource: TaskQueue,
  context: {
    workflowId: String,
    parameterCount: Long,
    parameters: StringArgument,
  },
};
