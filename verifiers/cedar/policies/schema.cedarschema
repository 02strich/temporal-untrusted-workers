// Cedar schema for the temporal-proxy tool-call verifier.
//
// Every tool call - a Nexus operation, or an activity on another task queue -
// is evaluated as one authorization request:
//   principal: the worker identity completing the workflow task
//   action:    the tool, Action::"<endpoint>/<service>/<operation>" or
//              Action::"<taskQueue>/<activityType>"
//   resource:  the task queue that issued the workflow task token
//   context:   the calling workflow's ID, the tool call's parameters, and the
//              context the workflow has received:
//                workflowInput  its start input: {name, parameters}
//                events         the latest activity result, Nexus result,
//                               signal and update of each name:
//                               events.<type>["<name>"] = {type, name, count, parameters}
//
// Parameters always have the same shape: {arg0: {type, data}, arg1: …}, where
// data is the payload's content. Each tool is its own action and declares its
// parameters below; workflow inputs and events declare theirs in
// WorkflowInput and Events. Anything a policy uses must be declared here, and
// Cedar's default deny rejects tools no policy permits.

// The calling worker identity, keyed by its subject.
entity Worker = {
  // The namespace the identity (and the calling workflow) is pinned to.
  namespace: String,
};

// The task queue that issued the workflow task token being completed.
entity TaskQueue = {
  name: String,
  namespace: String,
};

// The workflow's start input (the demo's ToolWorkflow takes one JSON object).
type WorkflowInput = {
  name: String,
  parameters: {
    arg0?: {
      type: String,
      data: {
        case?: String,
        customerEmail?: String,
        refundId?: String,
      },
    },
  },
};

// The latest input event of each name, by type. Declare the names (and
// their parameters) your policies use; activity and Nexus names contain "/",
// so quote them, e.g. "crm/LookupCustomer"?: {...}.
type Events = {
  activity: {},
  nexus: {},
  signal: {
    // An approval, e.g. {"refundId": "R-1001", "approvedBy": "manager@example.com"}.
    approval?: {
      type: String,
      name: String,
      count: Long,
      parameters: {
        arg0?: {
          type: String,
          data: {
            refundId?: String,
            approvedBy?: String,
          },
        },
      },
    },
  },
  update: {},
};

// Parameters of a tool taking a single plain JSON string
// (google.protobuf.Value), e.g. an SDK call with one string argument.
type StringArgument = {
  arg0?: {
    type: String,
    data: { value?: String },
  },
};

// Parameters of payments/billing/Charge: one JSON object argument.
type ChargeArguments = {
  arg0?: {
    type: String,
    data: {
      amount?: Long,
      currency?: String,
    },
  },
};

action "echo/echo/Echo" appliesTo {
  principal: Worker,
  resource: TaskQueue,
  context: {
    workflowId: String,
    parameterCount: Long,
    parameters: StringArgument,
    workflowInput: WorkflowInput,
    events: Events,
    inputEventsComplete: Bool,
  },
};

action "payments/billing/Charge" appliesTo {
  principal: Worker,
  resource: TaskQueue,
  context: {
    workflowId: String,
    parameterCount: Long,
    parameters: ChargeArguments,
    workflowInput: WorkflowInput,
    events: Events,
    inputEventsComplete: Bool,
  },
};

action "trusted-tools/SendEmail" appliesTo {
  principal: Worker,
  resource: TaskQueue,
  context: {
    workflowId: String,
    parameterCount: Long,
    parameters: StringArgument,
    workflowInput: WorkflowInput,
    events: Events,
    inputEventsComplete: Bool,
  },
};

action "trusted-tools/IssueRefund" appliesTo {
  principal: Worker,
  resource: TaskQueue,
  context: {
    workflowId: String,
    parameterCount: Long,
    parameters: StringArgument,
    workflowInput: WorkflowInput,
    events: Events,
    inputEventsComplete: Bool,
  },
};
